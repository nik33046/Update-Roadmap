# ── Required ───────────────────────────────────────────────────────────────────
# Base URL of the JIRA instance (no trailing slash)
JIRA_URL=https://yourcompany.atlassian.net

# JIRA user e-mail / username used for Basic Auth
JIRA_USER=you@yourcompany.com

# JIRA API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-jira-api-token

# Numeric ID of the JIRA board to query (visible in the board URL: rapidView=<ID>)
JIRA_BOARD_ID=123

# Google Drive file ID of wd-roadmap.html
# (the long string in the Drive URL: /d/<FILE_ID>/edit)
GDRIVE_FILE_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Contents of the Google service-account credentials JSON (entire JSON object as a string)
# Grant the service account "Editor" access to the target Drive file.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"roadmap-updater@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ── Optional (override default custom-field IDs) ───────────────────────────────
# JIRA custom field ID for Epic Link (default: customfield_10014)
# JIRA_EPIC_LINK_FIELD=customfield_10014

# JIRA custom field ID for Initiative (default: customfield_10020)
# JIRA_INITIATIVE_FIELD=customfield_10020

# JIRA custom field ID for Business Objective (default: customfield_10021)
# JIRA_BIZ_OBJ_FIELD=customfield_10021
